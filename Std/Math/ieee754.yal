const F32_Min_Subnormal = bitcast(f32, cast(u32, 0x00000001));
const F32_Max_Subnormal = bitcast(f32, cast(u32, 0x007fffff));
const F32_Min_Normal    = bitcast(f32, cast(u32, 0x00800000));
const F32_Max_Normal    = bitcast(f32, cast(u32, 0x7f7fffff));
const F32_Min           = F32_Min_Subnormal;
const F32_Max           = F32_Max_Normal;
const F32_Inf           = bitcast(f32, cast(u32, 0x7f800000));
const F32_NaN           = bitcast(f32, cast(u32, 0x7fffffff));
const F32_qNaN          = bitcast(f32, cast(u32, 0x7fc00001));
const F32_sNaN          = bitcast(f32, cast(u32, 0x7f800001));

const F64_Min_Subnormal = bitcast(f64, cast(u64, 0x0000000000000001));
const F64_Max_Subnormal = bitcast(f64, cast(u64, 0x000fffffffffffff));
const F64_Min_Normal    = bitcast(f64, cast(u64, 0x0010000000000000));
const F64_Max_Normal    = bitcast(f64, cast(u64, 0x7fefffffffffffff));
const F64_Min           = F64_Min_Subnormal;
const F64_Max           = F64_Max_Normal;
const F64_Inf           = bitcast(f64, cast(u64, 0x7ff0000000000000));
const F64_NaN           = bitcast(f64, cast(u64, 0x7fffffffffffffff));
const F64_qNaN          = bitcast(f64, cast(u64, 0x7ff8000000000001));
const F64_sNaN          = bitcast(f64, cast(u64, 0x7ff0000000000001));

