const UTF8String = struct {
    var count: s64;
    var data: *u8;
}

const MakeUTF8String = func(str: string) -> UTF8String {
    return .{str.count, str.data};
}

const GetUTF8DecodingSize = func(first_byte: u8) -> s64 {
    if first < 0x80 {
        return 1;
    } else if (first & 0xe0) == 0xc0 {
        return 2;
    } else if (first & 0xf0) == 0xe0 {
        return 3;
    } else if (first & 0xf8) == 0xf0 {
        return 4;
    } else {
        return 0;
    }
}

const GetUTF8DecodingLength = func(str: UTF8String) -> Std.Result(s64, ErrorCode) {
    var length = 0;
    var i = 0;
    while i < str.count {
        var size = GetUTF8DecodingSize(str.data[i]);

        if size == 0 {
            return .Error.{.SourceIllegal};
        }

        if i + size > str.count {
            return .Error.{.SourceExhausted};
        }

        i += size;
        length += 1;
    }

    return .Ok{length};
}

const UTF8DecodeCodepoint = func(buffer: []u8, byte_offset: s64) -> Std.Result((codepoint: u32, size: s64), ErrorCode) {

}

const UTF8DecodeToNewString = func(str: UTF8String) -> Std.Result([]u32, ErrorCode) {
}

const UTF8DecodeToBuffer = func(str: UTF8String, buffer: []u32) -> Std.Result(s64, ErrorCode) {
}

const UTF8Decode = func {
    UTF8DecodeCodepoint;
    UTF8DecodeToNewString;
    UTF8DecodeToBuffer;
}

const GetUTF8EncodingSize = func(codepoint: u32) -> s64 {
    if codepoint <= 0x7f  {
        return 1;
    } else if codepoint <= 0x7ff {
        return 2;
    } else if codepoint <= 0xffff {
        return 3;
    } else if codepoint <= 0x10ffff {
        return 4;
    }

    return 3; // Encoding size for Replacement_Codepoint
}

const GetUTF8EncodingLength = func(str: []u32) -> s64 {
    var size = 0;
    for i: 0..<str.count {
        size += GetUTF8EncodingSize(str[i]);
    }

    return size;
}

const UTF8EncodeCodepoint = func(codepoint: u32, output_buffer: []u8, byte_offset: s64) -> Std.Result(s64, ErrorCode) {
    if codepoint > Max_Codepoint {
        codepoint = Replacement_Codepoint;
    }

    var size = GetUTF8EncodingSize(codepoint);
    if byte_offset + size > buffer.count {
        return .Error.{.BufferTooSmall};
    }

    for i: 1=..size - 1 {
        output_buffer[byte_offset + i] = auto (codepoint | 0x80) & 0xbf;
        codepoint >>= 6;
    }

    const First_Byte_Mark = u8.[0x00,0x00,0xc0,0xe0,0xf0];
    output_buffer[byte_offset] = auto (codepoint | First_Byte_Mark[size]);

    return .Ok.{size};
}

const UTF8EncodeToNewString = func(str: []u32) -> Std.Result(UTF8String, ErrorCode) {
    var length = GetUTF8EncodingLength(str);
    var buffer = Mem.AllocArray(u8, length, initialize=false);

    var result = UTF8Encode(str, buffer);
    if result.kind == .Error {
        return .Error.{result.Error};
    }

    Std.Assert(Std.Get(result) == buffer.count, "Num encoded bytes is not the same as num allocated bytes");

    return .Ok.{buffer};
}

const UTF8EncodeToBuffer = func(str: []u32, buffer: []u8) -> Std.Result(s64, ErrorCode) {
    var byte_offset = 0;
    for i: 0..<str.count {
        var encode_char = UTF8EncodeCodepoint(str[i], buffer, byte_offset);
        if encode_char.kind == .Error {
            return .Error.{encode_char.Error};
        }

        byte_offset += Std.Get(encode_char);
    }

    return .Ok.{byte_offset};
}

const UTF8Encode = func {
    UTF8EncodeCodepoint;
    UTF8EncodeToNewString;
    UTF8EncodeToBuffer;
}
