const RELEASED = 0;
const PRESSED  = 1;

const EventType = enum u32 {
    FIRSTEVENT     = 0;

    /* Application events */
    QUIT           = 0x100;

    /* iOS events */
    APP_TERMINATING;
    APP_LOWMEMORY;
    APP_WILLENTERBACKGROUND;
    APP_DIDENTERBACKGROUND;
    APP_WILLENTERFOREGROUND;
    APP_DIDENTERFOREGROUND;

    WINDOWEVENT    = 0x200;
    SYSWMEVENT;

    /* Keyboard events */
    KEYDOWN        = 0x300;
    KEYUP;
    TEXTEDITING;
    TEXTINPUT;
    KEYMAPCHANGED;

    /* Mouse events */
    MOUSEMOTION    = 0x400;
    MOUSEBUTTONDOWN;
    MOUSEBUTTONUP;
    MOUSEWHEEL;

    /* Joystick events */
    JOYAXISMOTION  = 0x600;
    JOYBALLMOTION;
    JOYHATMOTION;
    JOYBUTTONDOWN;
    JOYBUTTONUP;
    JOYDEVICEADDED;
    JOYDEVICEREMOVED;

    /* Game controller events */
    CONTROLLERAXISMOTION  = 0x650;
    CONTROLLERBUTTONDOWN;
    CONTROLLERBUTTONUP;
    CONTROLLERDEVICEADDED;
    CONTROLLERDEVICEREMOVED;
    CONTROLLERDEVICEREMAPPED;

    /* Touch events */
    FINGERDOWN      = 0x700;
    FINGERUP;
    FINGERMOTION;

    /* Gesture events */
    DOLLARGESTURE   = 0x800;
    DOLLARRECORD;
    MULTIGESTURE;

    /* Clipboard events */
    CLIPBOARDUPDATE = 0x900;

    /* Drag and drop events */
    DROPFILE        = 0x1000;
    DROPTEXT;
    DROPBEGIN;
    DROPCOMPLETE;

    /* Audio hotplug events */
    AUDIODEVICEADDED = 0x1100;
    AUDIODEVICEREMOVED;

    /* Render events */
    RENDER_TARGETS_RESET = 0x2000;
    RENDER_DEVICE_RESET;

    USEREVENT    = 0x8000;
    LASTEVENT    = 0xFFFF;
}

const CommonEvent = struct {
    var type: EventType;
    var timestamp: u32;   // In milliseconds, populated using SDL_GetTicks()
}

const WindowEventID = enum u8 {
    NONE;
    SHOWN;
    HIDDEN;
    EXPOSED;
    MOVED;
    RESIZED;
    SIZE_CHANGED;
    MINIMIZED;
    MAXIMIZED;
    RESTORED;
    ENTER;
    LEAVE;
    FOCUS_GAINED;
    FOCUS_LOST;
    CLOSE;
    TAKE_FOCUS;
    HIT_TEST;
}

const WindowEvent = struct {
    var type: EventType;        // SDL_WINDOWEVENT
    var timestamp: u32;
    var windowID: u32;              // The associated window
    var event: WindowEventID;   // SDL_WindowEventID
    var padding1: u8;
    var padding2: u8;
    var padding3: u8;
    var data1: s32;             // event dependent data
    var data2: s32;             // event dependent data
}

const KeyboardEvent = struct {
    var type: EventType;    // SDL_KEYDOWN or SDL_KEYUP
    var timestamp: u32;         // In milliseconds, populated using SDL_GetTicks()
    var windowID: u32;          // The window with keyboard focus, if any
    var state: u8;              // SDL_PRESSED or SDL_RELEASED
    var repeat: u8;             // Non-zero if this is a key repeat
    var padding2: u8;
    var padding3: u8;
    var keysym: Keysym;     // The key that was pressed or released
}

const TEXTEDITINGEVENT_TEXT_SIZE = 32;

const TextEditingEvent = struct {
    var type: EventType;    // SDL_TEXTEDITING
    var timestamp: u32;
    var windowID: u32;
    var text: [TEXTEDITINGEVENT_TEXT_SIZE]u8;  // The editing text
    var start: s32;                                 // The start cursor of selected editing text
    var length: s32;                                // The length of selected editing text
}

const TEXTINPUTEVENT_TEXT_SIZE = 32;

const TextInputEvent = struct {
    var type: EventType;    // SDL_TEXTINPUT
    var timestamp: u32;
    var windowID: u32;
    var text: [TEXTINPUTEVENT_TEXT_SIZE]s8;  // The input text
}

const MouseMotionEvent = struct {
    var type: EventType;    // SDL_MOUSEMOTION
    var timestamp: u32;
    var windowID: u32;
    var which: u32;             // The mouse instance id, or SDL_TOUCH_MOUSEID
    var state: u32;             // The current button state
    var x: s32;                 // X coordinate, relative to window
    var y: s32;                 // Y coordinate, relative to window
    var xrel: s32;              // The relative motion in the X direction
    var yrel: s32;              // The relative motion in the Y direction
}

const MouseButtonEvent = struct {
    var type: EventType;    // SDL_MOUSEBUTTONDOWN or SDL_MOUSEBUTTONUP
    var timestamp: u32;
    var windowID: u32;
    var which: u32;             // The mouse instance id, or SDL_TOUCH_MOUSEID
    var button: u8;             // The mouse button index
    var state: u8;              // ::SDL_PRESSED or ::SDL_RELEASED
    var clicks: u8;             // 1 for single-click, 2 for double-click, etc.
    var padding1: u8;
    var x: s32;                 // X coordinate, relative to window
    var y: s32;                 // Y coordinate, relative to window
}

const MouseWheelEvent = struct {
    var type: EventType;    // SDL_MOUSEWHEEL
    var timestamp: u32;
    var windowID: u32;
    var which: u32;             // The mouse instance id, or SDL_TOUCH_MOUSEID
    var x: s32;                 // The amount scrolled horizontally, positive to the right and negative to the left
    var y: s32;                 // The amount scrolled vertically, positive away from the user and negative toward the user
    var direction: u32;         // Set to one of the SDL_MOUSEWHEEL_* defines. When FLIPPED the values in X and Y will be opposite. Multiply by -1 to change them back
}

const JoyAxisEvent = struct {
    var type: EventType;    // SDL_JOYAXISMOTION
    var timestamp: u32;
    var which: JoystickID;  // The joystick instance id
    var axis: u8;               // The joystick axis index
    var padding1: u8;
    var padding2: u8;
    var padding3: u8;
    var value: s16;             // The axis value (range: -32768 to 32767)
    var padding4: u16;
}

const JoyBallEvent = struct {
    var type: EventType;    // SDL_JOYBALLMOTION
    var timestamp: u32;
    var which: JoystickID;  // The joystick instance id
    var ball: u8;               // The joystick trackball index
    var padding1: u8;
    var padding2: u8;
    var padding3: u8;
    var xrel: s16;              // The relative motion in the X direction
    var yrel: s16;              // The relative motion in the Y direction
}

const JoyHatEvent = struct {
    var type: EventType;    // SDL_JOYHATMOTION
    var timestamp: u32;
    var which: JoystickID;  // The joystick instance id
    var hat: u8;                // The joystick hat index
    var value: u8;              // The hat position value.
    var padding1: u8;
    var padding2: u8;
}

const JoyButtonEvent = struct {
    var type: EventType;    //SDL_JOYBUTTONDOWN or SDL_JOYBUTTONUP
    var timestamp: u32;
    var which: JoystickID;  // The joystick instance id
    var button: u8;             // The joystick button index
    var state: u8;              // SDL_PRESSED or SDL_RELEASED
    var padding1: u8;
    var padding2: u8;
}

const JoyDeviceEvent = struct {
    var type: EventType;    // SDL_JOYDEVICEADDED or SDL_JOYDEVICEREMOVED
    var timestamp: u32;
    var which: s32;             // The joystick device index for the ADDED event, instance id for the REMOVED event
}

const ControllerAxisEvent = struct {
    var type: EventType;    // SDL_CONTROLLERAXISMOTION
    var timestamp: u32;
    var which: JoystickID;  // The joystick instance id
    var axis: u8;               // The controller axis (SDL_GameControllerAxis)
    var padding1: u8;
    var padding2: u8;
    var padding3: u8;
    var value: s16;             // The axis value (range: -32768 to 32767)
    var padding4: u16;
}

const ControllerButtonEvent = struct {
    var type: EventType;    // SDL_CONTROLLERBUTTONDOWN or SDL_CONTROLLERBUTTONUP
    var timestamp: u32;
    var which: JoystickID;  // The joystick instance id
    var button: u8;             // The controller button (SDL_GameControllerButton)
    var state: u8;              // SDL_PRESSED or SDL_RELEASED
    var padding1: u8;
    var padding2: u8;
}

const ControllerDeviceEvent = struct {
    var type: EventType;    // SDL_CONTROLLERDEVICEADDED, SDL_CONTROLLERDEVICEREMOVED, or SDL_CONTROLLERDEVICEREMAPPED
    var timestamp: u32;
    var which: s32;             // The joystick device index for the ADDED event, instance id for the REMOVED or REMAPPED event
}

const AudioDeviceEvent = struct {
    var type: EventType;
    var timestamp: u32;
}

const QuitEvent = struct {
    var type: EventType;
    var timestamp: u32;
}

const UserEvent = struct {
    var type: EventType;
    var timestamp: u32;
}

const SysWMEvent = struct {
    var type: EventType;
    var timestamp: u32;
}

const TouchFingerEvent = struct {
    var type: EventType;
    var timestamp: u32;
}

const MultiGestureEvent = struct {
    var type: EventType;
    var timestamp: u32;
}

const DollarGestureEvent = struct {
    var type: EventType;
    var timestamp: u32;
}

const DropEvent = struct {
    var type:      EventType; // SDL_DROPBEGIN or SDL_DROPFILE or SDL_DROPTEXT or SDL_DROPCOMPLETE
    var timestamp: u32;           // In milliseconds, populated using SDL_GetTicks()
    var file:      *u8;           // The file name, which should be freed with SDL_free(), is NULL on begin/complete
    var windowID:  u32;           // The window that was dropped on, if any
}

const Event = union {
    var type: EventType;
    var common: CommonEvent;         // Common event data
    var window: WindowEvent;         // Window event data
    var key: KeyboardEvent;          // Keyboard event data
    var edit: TextEditingEvent;      // Text editing event data
    var text: TextInputEvent;        // Text input event data
    var motion: MouseMotionEvent;    // Mouse motion event data
    var button: MouseButtonEvent;    // Mouse button event data
    var wheel: MouseWheelEvent;      // Mouse wheel event data
    var jaxis: JoyAxisEvent;         // Joystick axis event data
    var jball: JoyBallEvent;         // Joystick ball event data
    var jhat: JoyHatEvent;           // Joystick hat event data
    var jbutton: JoyButtonEvent;     // Joystick button event data
    var jdevice: JoyDeviceEvent;     // Joystick device change event data
    var caxis: ControllerAxisEvent;      // Game Controller axis event data
    var cbutton: ControllerButtonEvent;  // Game Controller button event data
    var cdevice: ControllerDeviceEvent;  // Game Controller device event data
    var adevice: AudioDeviceEvent;   // Audio device event data
    var quit: QuitEvent;             // Quit request event data
    var user: UserEvent;             // Custom event data
    var syswm: SysWMEvent;           // System dependent window event data
    var tfinger: TouchFingerEvent;   // Touch finger event data
    var mgesture: MultiGestureEvent; // Gesture event data
    var dgesture: DollarGestureEvent; // Gesture event data
    var drop: DropEvent;             // Drag and drop event data

    var fit_size: [56]u8;
}

#assert size_of(Event) == 56;

const eventaction = enum u32 {
    ADDEVENT;
    PEEKEVENT;
    GETEVENT;
}

@external @library(Lib_SDL2) {

@symbol("SDL_PumpEvents")
const PumpEvents = func();
@symbol("SDL_PeepEvents")
const PeepEvents = func(events: *Event, numevents: s32, action: eventaction, minType: u32, maxType: u32) -> s32;
@symbol("SDL_HasEvent")
const HasEvent = func(type: u32) -> Bool;
@symbol("SDL_HasEvents")
const HasEvents = func(minType: u32, maxType: u32) -> Bool;
@symbol("SDL_FlushEvent")
const FlushEvent = func(type: u32);
@symbol("SDL_FlushEvents")
const FlushEvents = func(minType: u32, maxType: u32);
@symbol("SDL_PollEvent")
const PollEvent = func(event: *Event) -> s32;
@symbol("SDL_WaitEvent")
const WaitEvent = func(event: *Event) -> s32;
@symbol("SDL_WaitEventTimeout")
const WaitEventTimeout = func(event: *Event, timeout: s32) -> s32;
@symbol("SDL_PushEvent")
const PushEvent = func(event: *Event) -> s32;

}
