#include "basic.yal.ignore";

const main = func() -> s32 {
    {
        var a = 0;
        for i: 0..=10 {
            a += 1;
        }

        Assert(a == 11);
    }
    {
        var a = 0;
        for i: 0..<10 {
            a += 1;
        }

        Assert(a == 10);
    }
    {
        var a = 0;
        for i: 0..=-10 {
            a += 1;
        }

        Assert(a == 0);
    }
    {
        var a = 0;
        for i: 0..<-10 {
            a += 1;
        }

        Assert(a == 0);
    }
    {
        var a = 2;
        for i: 2..=10 {
            a += 1;
        }

        Assert(a == 11);
    }
    {
        var a = 0;
        var b = 10;
        for i: a..=b {
            b += 1;
            a += 1;
        }

        Assert(a == 11);
    }
    {
        var a = 0;
        for i: 0..<10 {
            Assert(i == a);
            a += 1;
        }
    }
    {
        for i: 0..<0 {
        }

        for i: 0..<0 {
        }
    }
    {
        var index: int;
        for index= 0..<10 {
        }

        Assert(index == 10);
    }
    {
        var i = 5;
        var a = 0;
        for i= i..<10 {
            a += 1;
        }

        Assert(a == 5);
    }
    {
        var a = 0;
        for i: 0>..10 {
            a += 1;
        }

        Assert(a == 10);
    }
    {
        var a = 0;
        for i: 0=..10 {
            a += 1;
        }

        Assert(a == 11);
    }
    {
        var i = 0;
        for i= 0>..10 {
        }

        Assert(i == 0);
    }
    {
        var i = 0;
        for i= 0=..10 {
        }

        Assert(i == -1);
    }
}
