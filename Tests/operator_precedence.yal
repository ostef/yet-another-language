#include "basic.yal.ignore";

// Precedence order:
// ||
// &&
// ==, !=, <, >, <=, >=
// <<, >>
// |
// ^
// &
// +, -
// *, /, %
// -a, !a, ^a, &a, *a
// cast, size_of
// a.b, a[b], a(b,c,d)

const main = func() -> s32 {
    var a = 1 + 2 * 3;
    Assert(a == 7);

    var b = (1 + 2) * 3;
    Assert(b == 9);

    var c = 1 + 2 / 3 & 1;
    Assert(c == (1 + (2 / 3)) & 1);

    var d = 1 + 2 * 5 == 11;
    Assert(d == true);

    // var e = 1 + 2 * 5 == 11 == true; // Should not compile
    var e = (1 + 2 * 5 == 11) == true;
    Assert(e == true);

    var f = 100 * 2 >> 1 >> 1;
    Assert(f == (100 * 2) >> 1 >> 1);
}
