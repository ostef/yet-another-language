#include "basic.yal.ignore";

// @Todo
// This test does not seem so useful because
// it does not actually test the results of
// the nested if and while statements

const Foo = func(val : int) -> int {
    return val * 100;
}

const main = func() -> s32 {
    var a = 0;
    if Foo(a) < -10 {
        if Foo(10) == 1 {
            a = 1;
        } else {
            var i = 0;
            while i < 100 {
                a += 2;
                i += 1;
            }
        }
    } else if Foo(2) == 30 {
        a = Foo(Foo(Foo(Foo(1))));
    } else {
        a = Foo(Foo(Foo(30)));
    }

    Assert(a == 30000000);

    if true
        var b = 10; // Should be created in the scope of if

    if true {
        var d = 10;
    } else {
        var d = 11;
    }

    if true
        var d = 10;
    else
        var d = 11;

    var b = 11;
    Assert(b == 11);

    while false {
        var c = 12;
    }

    while false
        var c = 12;

    var c = 13;
    Assert(c == 13);
}
