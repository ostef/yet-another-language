#include "basic.yal.ignore";

const Foo = func(x: int, y: int, z: int) -> int {
    return y + x * z;
}

const Bar = func(a: string, b: string, c: string) {
}

const Baz = func {
    Foo;
    Bar;
}

const main = func() -> s32 {
    var i = Baz(10, z=2, y=3);
    Assert(i == 23);

    Baz("Hello", c="!", b="World");
}
